# ─────────────────────────────────────────────────────────────
# SVATEH — environment variables
# Local dev: copy to apps/web/.env.local
# Vercel:   Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Public URL of the store (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://svateh.com

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/svateh?retryWrites=true&w=majority

# Long random string used to sign login sessions (32+ chars).
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# Optional: require this key on the one-time /admin/setup screen
ADMIN_SETUP_KEY=

# AWS S3 — product & content images (see README → S3 setup)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=svateh-media-034816347610
# Optional: CloudFront or custom domain in front of the bucket
S3_PUBLIC_URL=

# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (resend.com → API Keys). EMAIL_FROM must use a verified domain.
RESEND_API_KEY=
EMAIL_FROM=SVATEH <orders@svateh.com>
# Where new-order & contact-form notifications go (defaults to the support email in Site settings)
STORE_NOTIFY_EMAIL=

# Protects the cron endpoint (Vercel sends it automatically when set)
CRON_SECRET=
